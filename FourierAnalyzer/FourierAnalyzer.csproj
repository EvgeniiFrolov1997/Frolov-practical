<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FourierAnalyzer</RootNamespace>
    <AssemblyName>FourierAnalyzer</AssemblyName>
  </PropertyGroup>

  <!-- Пакеты устанавливаются через менеджер NuGet:
       MathNet.Numerics - вычисление быстрого преобразования Фурье
       NAudio           - чтение звуковых файлов (wav, mp3)
       OxyPlot.Wpf      - построение графиков -->
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
  </ItemGroup>

</Project>
